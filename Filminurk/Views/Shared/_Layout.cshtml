@using Microsoft.AspNetCore.Identity
@inject SignInManager<Filminurk.Core.Domain.ApplicationUser> signInManager;


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Filminurk</title>
    <meta name="theme-color" content="#0B0D12"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Filminurk.styles.css" asp-append-version="true" />
</head>

<body class="app-body">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
            <div class="container site-navbar__container">
                <!-- Brand -->
                <a class="navbar-brand site-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="site-brand__mark">F</span>

                    <span class="site-brand__text">
                        <span class="site-brand__name">Filminurk</span>
                        <span class="site-brand__tagline">MOVIE SPACE</span>
                    </span>
                </a>

                <!-- Mobile menu button -->
                <button class="navbar-toggler site-navbar__toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav site-nav-links me-auto">
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-area="" asp-controller="Movies" asp-action="Index">Movies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-area="" asp-controller="Actors" asp-action="Index">Actors</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link site-nav-link" asp-area="" asp-controller="FavoriteLists" asp-action="Index">Favorite Lists</a>
                        </li>

                        <!-- Additional navigation -->
                        <li class="nav-item dropdown site-nav-dropdown">
                            <a class="nav-link dropdown-toggle site-nav-link" href="#" id="moreDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">More</a>

                            <ul class="dropdown-menu dropdown-menu-dark" aria-labelledby="moreDropdown">
                                <li class="nav-item">
                                    <a class="nav-link site-nav-link" asp-area="" asp-controller="UserComments" asp-action="Index">UserComments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link site-nav-link" asp-area="" asp-controller="Emails" asp-action="Index">Email</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link site-nav-link" asp-area="" asp-controller="AccuWeather" asp-action="Index">Weather</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link site-nav-link" asp-area="" asp-controller="Omdb" asp-action="Index">OMDB-api</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link site-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Auth -->
                    <ul class="navbar-nav site-nav-actions">
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" asp-area="" asp-controller="SignalRChat" asp-action="Index">Chat</a>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-controller="Accounts" asp-action="Logout" class="site-logout-form">
                                    <button type="submit" class="btn btn-outline-light site-auth-button">
                                        Sign out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" asp-area="" asp-controller="Accounts" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary site-auth-button site-register-button" asp-area="" asp-controller="Accounts" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main content -->
    <div class="container app-content">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>&copy; @DateTime.Now.Year Filminurk</span>

            <span class="site-footer__tagline">Movies are our life.</span>

            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
